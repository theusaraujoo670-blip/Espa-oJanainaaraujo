    <!-- FLOATING WHATSAPP BUTTON (Always Visible) -->
    <a href="https://wa.me/81994050595?text=Ol%C3%A1!%20Gostaria%20de%20agendar%20um%20hor%C3%A1rio%20no%20Studio.%20Poderia%20me%20informar%20os%20hor%C3%A1rios%20dispon%C3%ADveis%3F" 
