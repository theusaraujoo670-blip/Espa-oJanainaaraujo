       aria-label="Fazer agendamento no WhatsApp"
       class="btn-whatsapp-dynamic fixed bottom-6 right-6 z-50 bg-emerald-500 hover:bg-emerald-600 text-white w-14 h-14 rounded-full shadow-2xl flex items-center justify-center text-3xl hover:scale-110 transition-transform duration-300 animate-pulse-subtle">
        <i class="fa-brands fa-whatsapp"></i>
