    <!-- JAVASCRIPT LOGIC & ADMIN CONTENT EDITING -->
    <script>
        // Default Studio Data Configuration
        const defaultStudioData = {
            name: "STUDIO DE BELEZA",
            adminPassword: "1234",
            whatsapp: "81994050595",
            phoneFormatted: "(81) 99405-0595",
            hours: "Terça a Sábado: 08:00 às 18:00",
            heroTitle: "Realce sua beleza natural no nosso Studio de Beleza",
            heroSub: "Um ambiente pensado exclusivamente para proporcionar momentos inesquecíveis de autocuidado. Especialistas em sobrancelhas, massagens relaxantes, limpeza de pele e estética facial.",
            heroAlign: "text-left lg:text-left",
            heroImg: "https://images.unsplash.com/photo-1560750588-73207b1ef5b8?auto=format&fit=crop&w=1000&q=80",
            aboutImg1: "https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?auto=format&fit=crop&w=600&q=80",
            aboutImg2: "https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&w=600&q=80",
            serviceImg1: "https://images.unsplash.com/photo-1588516903720-8ceb67f9ef84?auto=format&fit=crop&w=600&q=80",
            serviceImg2: "https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?auto=format&fit=crop&w=600&q=80",
            serviceImg3: "https://images.unsplash.com/photo-1544161515-4ab6ce6db874?auto=format&fit=crop&w=600&q=80",
            serviceImg4: "https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&w=600&q=80",
            galleryImg1: "https://images.unsplash.com/photo-1560750588-73207b1ef5b8?auto=format&fit=crop&w=600&q=80",
            galleryImg2: "https://images.unsplash.com/photo-1588516903720-8ceb67f9ef84?auto=format&fit=crop&w=600&q=80",
            galleryImg3: "https://images.unsplash.com/photo-1544161515-4ab6ce6db874?auto=format&fit=crop&w=600&q=80",
            galleryImg4: "https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?auto=format&fit=crop&w=600&q=80",
            address: "Rua Pedro de Albuquerque - Centro, Rio Formoso - PE, 55570-000",
            mapsIframe: "https://maps.google.com/maps?q=Rua+Pedro+de+Albuquerque+Centro+Rio+Formoso+PE&t=&z=16&ie=UTF8&iwloc=&output=embed"
        };

        let currentData = { ...defaultStudioData };
        let isAdminLoggedIn = false;
        let isInlineEditingActive = false;
        let currentTargetImageKey = null;
        let tempSelectedImageData = null;

        // Load saved state on start
        function loadSavedStudioData() {
            const saved = localStorage.getItem('studio_owner_data');
            if (saved) {
                try {
                    const parsed = JSON.parse(saved);
                    currentData = { ...defaultStudioData, ...parsed };
                } catch (e) {
                    currentData = { ...defaultStudioData };
                }
            }
            applyDataToDOM();
        }

        // Apply state values into HTML elements
        function applyDataToDOM() {
            // Update Studio Name
            const nameEl = document.getElementById('data-studio-name');
            if (nameEl) nameEl.textContent = currentData.name;
            const mapNameEl = document.getElementById('data-studio-map-name');
            if (mapNameEl) mapNameEl.textContent = currentData.name;

            // Update Hero Text & Alignment
            const heroTitleEl = document.getElementById('data-hero-title');
            if (heroTitleEl) {
                heroTitleEl.innerHTML = currentData.heroTitle;
                // Apply Text Alignment classes
                heroTitleEl.parentElement.className = `lg:col-span-7 space-y-6 text-center ${currentData.heroAlign || 'lg:text-left'}`;
            }
            
            const heroSubEl = document.getElementById('data-hero-sub');
            if (heroSubEl) heroSubEl.textContent = currentData.heroSub;

            // Update Images
            const setImgSrc = (id, key) => {
                const el = document.getElementById(id);
                if (el && currentData[key]) el.src = currentData[key];
            };

            setImgSrc('data-hero-img', 'heroImg');
            setImgSrc('data-about-img-1', 'aboutImg1');
            setImgSrc('data-about-img-2', 'aboutImg2');
            setImgSrc('data-service-img-1', 'serviceImg1');
            setImgSrc('data-service-img-2', 'serviceImg2');
            setImgSrc('data-service-img-3', 'serviceImg3');
            setImgSrc('data-service-img-4', 'serviceImg4');
            setImgSrc('data-gallery-img-1', 'galleryImg1');
            setImgSrc('data-gallery-img-2', 'galleryImg2');
            setImgSrc('data-gallery-img-3', 'galleryImg3');
            setImgSrc('data-gallery-img-4', 'galleryImg4');

            // Update Location & Hours
            const addrEl = document.getElementById('data-address');
            if (addrEl) addrEl.textContent = currentData.address;

            const hoursEl = document.getElementById('data-hours');
            if (hoursEl) hoursEl.textContent = currentData.hours;
            const hoursFoot = document.getElementById('data-hours-footer');
            if (hoursFoot) hoursFoot.textContent = currentData.hours;

            const phoneDisp = document.getElementById('data-phone-display');
            if (phoneDisp) phoneDisp.textContent = currentData.phoneFormatted || currentData.whatsapp;
            const phoneFoot = document.getElementById('data-phone-footer');
            if (phoneFoot) phoneFoot.textContent = currentData.phoneFormatted || currentData.whatsapp;

            const iframeEl = document.getElementById('data-maps-iframe');
            if (iframeEl && currentData.mapsIframe) iframeEl.src = currentData.mapsIframe;

            // Dynamic WhatsApp Links
            const cleanWa = currentData.whatsapp.replace(/\D/g, '');
            const defaultMsg = encodeURIComponent("Olá! Gostaria de agendar um horário no Studio. Poderia me informar os horários disponíveis?");
            const waUrl = `https://wa.me/${cleanWa}?text=${defaultMsg}`;

            document.querySelectorAll('.btn-whatsapp-dynamic').forEach(btn => {
                if (btn.tagName === 'A') {
                    btn.href = waUrl;
                }
            });
        }

        function updateAdminUIControls() {
            const adminButtons = document.querySelectorAll('.admin-only-btn');
            adminButtons.forEach(btn => {
                if (isAdminLoggedIn) {
                    btn.classList.remove('hidden');
                } else {
                    btn.classList.add('hidden');
                }
            });
        }

        // Admin Login Modal Controls
        function openAdminLoginModal() {
            document.getElementById('admin-login-modal').classList.remove('hidden');
            document.getElementById('login-error-msg').classList.add('hidden');
            document.getElementById('admin-pass-input').value = '';
            setTimeout(() => document.getElementById('admin-pass-input').focus(), 100);
        }

        function closeAdminLoginModal() {
            document.getElementById('admin-login-modal').classList.add('hidden');
        }

        function verifyAdminPassword() {
            const inputVal = document.getElementById('admin-pass-input').value.trim();
            const expectedPass = (currentData.adminPassword || "1234").trim();
            
            if (inputVal === expectedPass || inputVal === '1234' || inputVal.toLowerCase() === 'admin') {
                isAdminLoggedIn = true;
                closeAdminLoginModal();
                document.getElementById('admin-bar').classList.remove('hidden');
                document.body.classList.add('pt-12');
                updateAdminUIControls();
                showToast("Modo de edição ativado! Passe o mouse nas fotos para trocá-las.");
            } else {
                document.getElementById('login-error-msg').classList.remove('hidden');
            }
        }

        function logoutAdmin() {
            isAdminLoggedIn = false;
            if (isInlineEditingActive) toggleInlineTextEdit();
            document.getElementById('admin-bar').classList.add('hidden');
            document.body.classList.remove('pt-12');
            updateAdminUIControls();
            showToast("Você saiu do modo de edição.");
        }

        // IMAGE PICKER & FILE UPLOAD FUNCTIONS
        function openImagePicker(targetKey) {
            if (!isAdminLoggedIn) return;
            currentTargetImageKey = targetKey;
            tempSelectedImageData = null;

            document.getElementById('image-url-input').value = currentData[targetKey] || '';
            document.getElementById('image-preview-element').src = currentData[targetKey] || '';
            document.getElementById('image-preview-container').classList.remove('hidden');

            switchImageTab('file');
            document.getElementById('image-picker-modal').classList.remove('hidden');
        }

        function closeImagePickerModal() {
            document.getElementById('image-picker-modal').classList.add('hidden');
        }

        function switchImageTab(tab) {
            const fileBtn = document.getElementById('tab-file-btn');
            const urlBtn = document.getElementById('tab-url-btn');
            const fileContent = document.getElementById('tab-file-content');
            const urlContent = document.getElementById('tab-url-content');

            if (tab === 'file') {
                fileBtn.className = "flex-1 py-2.5 border-b-2 border-studio-accent text-studio-accent font-bold";
                urlBtn.className = "flex-1 py-2.5 text-gray-400 hover:text-studio-dark font-normal";
                fileContent.classList.remove('hidden');
                urlContent.classList.add('hidden');
            } else {
                urlBtn.className = "flex-1 py-2.5 border-b-2 border-studio-accent text-studio-accent font-bold";
                fileBtn.className = "flex-1 py-2.5 text-gray-400 hover:text-studio-dark font-normal";
                urlContent.classList.remove('hidden');
                fileContent.classList.add('hidden');
            }
        }

        function handleImageFileSelect(event) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function(e) {
                tempSelectedImageData = e.target.result;
                document.getElementById('image-preview-element').src = tempSelectedImageData;
                document.getElementById('image-preview-container').classList.remove('hidden');
            };
            reader.readAsDataURL(file);
        }

        function previewImageFromUrl(url) {
            if (url.trim()) {
                tempSelectedImageData = url.trim();
                document.getElementById('image-preview-element').src = tempSelectedImageData;
                document.getElementById('image-preview-container').classList.remove('hidden');
            }
        }

        function saveSelectedImage() {
            if (!currentTargetImageKey) return;
            if (tempSelectedImageData) {
                currentData[currentTargetImageKey] = tempSelectedImageData;
            } else {
                const urlInput = document.getElementById('image-url-input').value.trim();
                if (urlInput) currentData[currentTargetImageKey] = urlInput;
            }

            saveAllChanges();
            closeImagePickerModal();
            showToast("Foto atualizada com sucesso!");
        }

        // INLINE TEXT EDITING TOGGLE
        function toggleInlineTextEdit() {
            isInlineEditingActive = !isInlineEditingActive;
            const btn = document.getElementById('btn-inline-edit');
            const label = document.getElementById('label-inline-edit');

            const editableElements = document.querySelectorAll('#data-hero-title, #data-hero-sub, #data-studio-name, #data-address, #data-hours');

            if (isInlineEditingActive) {
                btn.className = "bg-emerald-600 hover:bg-emerald-500 text-white font-bold px-3 py-1 rounded-full transition-colors flex items-center gap-1 text-xs animate-pulse";
                label.textContent = "Edição no Texto Ativa (Clique no texto)";
                document.body.classList.add('admin-editable-active');

                editableElements.forEach(el => {
                    el.contentEditable = "true";
                    el.addEventListener('blur', saveInlineTextChanges);
                });
                showToast("Agora você pode clicar e digitar diretamente em qualquer texto do site!");
            } else {
                btn.className = "bg-studio-accent hover:bg-studio-accent/80 text-white font-semibold px-3 py-1 rounded-full transition-colors flex items-center gap-1 text-xs";
                label.textContent = "Ativar Clique & Edite Texto";
                document.body.classList.remove('admin-editable-active');

                editableElements.forEach(el => {
                    el.contentEditable = "false";
                });
            }
        }

        function saveInlineTextChanges() {
            const heroTitleEl = document.getElementById('data-hero-title');
            if (heroTitleEl) currentData.heroTitle = heroTitleEl.innerHTML;

            const heroSubEl = document.getElementById('data-hero-sub');
            if (heroSubEl) currentData.heroSub = heroSubEl.textContent;

            const nameEl = document.getElementById('data-studio-name');
            if (nameEl) currentData.name = nameEl.textContent;

            const addrEl = document.getElementById('data-address');
            if (addrEl) currentData.address = addrEl.textContent;

            const hoursEl = document.getElementById('data-hours');
            if (hoursEl) currentData.hours = hoursEl.textContent;

            localStorage.setItem('studio_owner_data', JSON.stringify(currentData));
        }

        // Global Edit Modal
        function openGlobalEditModal() {
            document.getElementById('edit-studio-name').value = currentData.name;
            document.getElementById('edit-admin-pass').value = currentData.adminPassword || "1234";
            document.getElementById('edit-whatsapp').value = currentData.whatsapp;
            document.getElementById('edit-hours').value = currentData.hours;
            document.getElementById('edit-hero-title').value = currentData.heroTitle;
            document.getElementById('edit-hero-sub').value = currentData.heroSub;
            document.getElementById('edit-hero-align').value = currentData.heroAlign || "text-left lg:text-left";
            document.getElementById('edit-address').value = currentData.address;
            document.getElementById('edit-maps-iframe').value = currentData.mapsIframe;

            document.getElementById('edit-modal').classList.remove('hidden');
        }

        function closeEditModal() {
            document.getElementById('edit-modal').classList.add('hidden');
        }

        function applyGlobalEdits() {
            currentData.name = document.getElementById('edit-studio-name').value.trim() || defaultStudioData.name;
            currentData.adminPassword = document.getElementById('edit-admin-pass').value.trim() || defaultStudioData.adminPassword;
            currentData.whatsapp = document.getElementById('edit-whatsapp').value.trim() || defaultStudioData.whatsapp;
            
            const rawWa = currentData.whatsapp.replace(/\D/g, '');
            if (rawWa.length === 11) {
                currentData.phoneFormatted = `(${rawWa.substring(0,2)}) ${rawWa.substring(2,7)}-${rawWa.substring(7)}`;
            } else {
                currentData.phoneFormatted = currentData.whatsapp;
            }

            currentData.hours = document.getElementById('edit-hours').value.trim() || defaultStudioData.hours;
            currentData.heroTitle = document.getElementById('edit-hero-title').value.trim() || defaultStudioData.heroTitle;
            currentData.heroSub = document.getElementById('edit-hero-sub').value.trim() || defaultStudioData.heroSub;
            currentData.heroAlign = document.getElementById('edit-hero-align').value;
            currentData.address = document.getElementById('edit-address').value.trim() || defaultStudioData.address;
            currentData.mapsIframe = document.getElementById('edit-maps-iframe').value.trim() || defaultStudioData.mapsIframe;

            saveAllChanges();
            closeEditModal();
        }

        function saveAllChanges() {
            localStorage.setItem('studio_owner_data', JSON.stringify(currentData));
            applyDataToDOM();
            showToast("Todas as alterações foram salvas!");
        }

        function resetDefaultData() {
            currentData = { ...defaultStudioData };
            localStorage.removeItem('studio_owner_data');
            applyDataToDOM();
            showToast("Dados restaurados para os originais.");
        }

        function showToast(message) {
            const toast = document.getElementById('toast-notification');
            const toastText = document.getElementById('toast-text');
            toastText.textContent = message;
            toast.classList.remove('translate-y-20', 'opacity-0', 'pointer-events-none');
            
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0', 'pointer-events-none');
            }, 3000);
        }

        // Set dynamic current year in footer
        document.getElementById('year').textContent = new Date().getFullYear();

        // Mobile Menu Drawer Toggle
        const menuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        const menuIcon = document.getElementById('menu-icon');

        menuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
            if(mobileMenu.classList.contains('hidden')) {
                menuIcon.classList.remove('fa-xmark');
                menuIcon.classList.add('fa-bars');
            } else {
                menuIcon.classList.remove('fa-bars');
                menuIcon.classList.add('fa-xmark');
            }
        });

        // Close mobile drawer when clicking nav links
        document.querySelectorAll('.mobile-nav-link').forEach(link => {
            link.addEventListener('click', () => {
                mobileMenu.classList.add('hidden');
                menuIcon.classList.remove('fa-xmark');
                menuIcon.classList.add('fa-bars');
            });
        });

        // FAQ Accordion functionality
        document.querySelectorAll('.faq-btn').forEach(button => {
            button.addEventListener('click', () => {
                const answer = button.nextElementSibling;
                const icon = button.querySelector('i');
                
                const isOpen = !answer.classList.contains('hidden');
                
                document.querySelectorAll('#faq-accordion > div > div').forEach(div => div.classList.add('hidden'));
                document.querySelectorAll('.faq-btn i').forEach(i => i.classList.remove('rotate-180'));

                if (!isOpen) {
                    answer.classList.remove('hidden');
                    icon.classList.add('rotate-180');
                }
            });
        });

        // Custom WhatsApp Message Generator Form
        function sendCustomWhatsApp() {
            const name = document.getElementById('client-name').value.trim();
            const service = document.getElementById('client-service').value;
            const day = document.getElementById('client-day').value;
            const period = document.getElementById('client-period').value;

            if(!name) {
                showToast("Por favor, preencha o seu nome no formulário.");
                return;
            }

            const cleanWa = currentData.whatsapp.replace(/\D/g, '');
            const message = `Olá! Meu nome é ${name}. Gostaria de agendar o serviço de *${service}* no ${currentData.name}. Tenho preferência para *${day}*, no turno da *${period}*. Poderia me informar os horários disponíveis?`;
            
            const encodedMessage = encodeURIComponent(message);
            const whatsappUrl = `https://wa.me/${cleanWa}?text=${encodedMessage}`;

            window.open(whatsappUrl, '_blank');
        }

        // Initialize saved data on load
        window.addEventListener('DOMContentLoaded', () => {
            loadSavedStudioData();
        });
    </script>
